{
  "name": "zotero-headless",
  "version": "1.0.0",
  "description": "Zotero Web API 同步客户端 - 无需桌面客户端即可实现文献库同步",
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "zotero": "./index.js"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "keywords": ["zotero", "sync", "bibliography", "academic"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^9.4.0",
    "drizzle-orm": "^0.29.0"
  },
  "devDependencies": {
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  }
}
