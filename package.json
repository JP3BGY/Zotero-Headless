{
  "name": "zotero-headless",
  "version": "1.0.0",
  "private": true,
  "description": "Zotero Web API 同步客户端 - 无需桌面客户端即可实现文献库同步",
  "scripts": {
    "build": "turbo run build",
    "bundle": "turbo run bundle --filter=@zotero-headless/cli --filter=@zotero-headless/shell",
    "package": "node scripts/package-for-npm.js",
    "dev": "turbo run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.5.0",
    "@types/node": "^25.2.3",
    "@vitest/coverage-v8": "^2.0.0",
    "prettier": "^3.2.0",
    "tar": "^7.5.9",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "turbo": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@8.12.0"
}
