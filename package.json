{
  "name": "zotero-headless",
  "version": "1.0.0",
  "private": true,
  "description": "Zotero Web API 同步客户端 - 无需桌面客户端即可实现文献库同步",
  "bin": {
    "zotero": "./apps/cli/dist/index.js"
  },
  "files": [
    "apps/**/dist/**/*",
    "packages/**/dist/**/*",
    "scripts/**/*",
    "package.json",
    "pnpm-workspace.yaml",
    "turbo.json"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "postinstall": "node scripts/postinstall.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.5.0",
    "@types/node": "^25.2.3",
    "esbuild": "^0.27.3",
    "prettier": "^3.2.0",
    "tsx": "^4.21.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "packageManager": "pnpm@8.12.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "axios": "^1.13.5",
    "better-sqlite3": "^11.9.1",
    "commander": "^14.0.3",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.30.10",
    "sql.js": "^1.14.0",
    "zod": "^4.3.6"
  }
}
